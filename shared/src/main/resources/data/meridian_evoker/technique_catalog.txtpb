# 五脏诀唯一功法目录：上卷「养」强身五式与炼元五式，中卷「附」五行附伤五式（数值全部占位，见 docs/wiki/Integration.md）。
schema_version: 1
namespace: "meridian_evoker"
binding_template_groups: "human:humanoid"
books { id: "meridian_evoker:five_organs" display_name: "五脏诀" }
volumes {
  id: "meridian_evoker:nourish"
  book_id: "meridian_evoker:five_organs"
  display_name: "养"
  techniques { id: "meridian_evoker:metal_arms" version: 1 }
  techniques { id: "meridian_evoker:earth_legs" version: 1 }
  techniques { id: "meridian_evoker:fire_heart" version: 1 }
  techniques { id: "meridian_evoker:water_return" version: 1 }
  techniques { id: "meridian_evoker:wood_sinew" version: 1 }
  techniques { id: "meridian_evoker:refine_lung" version: 1 }
  techniques { id: "meridian_evoker:refine_spleen" version: 1 }
  techniques { id: "meridian_evoker:refine_heart" version: 1 }
  techniques { id: "meridian_evoker:refine_kidney" version: 1 }
  techniques { id: "meridian_evoker:refine_liver" version: 1 }
  # 生存来源：玩家杀死会《养》的唤魔者（Threatening 学卷表的游炁、真炁两档）时掉一卷，概率占位。
  scroll_drops { entity_type: "minecraft:evoker" chance: 0.25 }
}
volumes {
  id: "meridian_evoker:infuse"
  book_id: "meridian_evoker:five_organs"
  display_name: "附"
  techniques { id: "meridian_evoker:metal_edge" version: 1 }
  techniques { id: "meridian_evoker:earth_quake" version: 1 }
  techniques { id: "meridian_evoker:fire_burn" version: 1 }
  techniques { id: "meridian_evoker:water_frost" version: 1 }
  techniques { id: "meridian_evoker:wood_thunder" version: 1 }
  # 先学会《养》全部十式才能学《附》。
  prerequisite_volume_ids: "meridian_evoker:nourish"
  # 生存来源同《养》：玩家杀死会这一卷的唤魔者（Threatening 学卷表的真炁档）时掉一卷，概率占位。
  scroll_drops { entity_type: "minecraft:evoker" chance: 0.25 }
}
definitions {
  id: "meridian_evoker:metal_arms"
  version: 1
  category: BUFF
  minimum_realm: WANDERING_QI
  movement_speed_multiplier: 0.4
  slots {
    id: "zang"
    module: ORGAN
    tags: "human:zang_metal"
    minimum_count: 1
    maximum_count: 2
  }
  slots {
    id: "channels"
    module: MERIDIAN
    tags: "human:meridian_metal"
    minimum_count: 1
    maximum_count: 4
    require_opened: true
  }
  slots {
    id: "muscles"
    module: TISSUE
    tags: "human:arm_muscle"
    minimum_count: 1
    maximum_count: 16
  }
  cost {
    qi {
      slot_id: "channels"
      attribute: "meridian:metal"
      phase: FREE
      matching: ATTRIBUTE_AT_LEAST_PHASE
      amount { value: 0.3 unit: QI }
      distribution: BY_BALANCE
    }
    work {
      slot_id: "zang"
      power { value: 10 unit: WATT }
      duration { value: 2 unit: SECOND }
    }
  }
  phases {
    warmup_millis: 2600
    active_millis: 0
    recovery_millis: 2000
    interruptible_by_damage: true
  }
  cooldown_millis: 22000
  effects { at_millis: 0 presentation { id: "meridian_evoker:evoker_metal_arms" duration: UNTIL_RECOVERY_END start_millis: 0 } }
  effects {
    at_millis: 1000
    sound { sound_id: "meridian_evoker:metal_arms.flap"
      volume { value: 0.6 unit: RATIO }
      pitch { value: 0.8 unit: RATIO }
      anchor: CASTER }
  }
  effects {
    at_millis: 2100
    sound { sound_id: "meridian_evoker:metal_arms.flap"
      volume { value: 0.6 unit: RATIO }
      pitch { value: 0.8 unit: RATIO }
      anchor: CASTER }
  }
  effects {
    at_millis: 2600
    status_benefit {
      id: "meridian_evoker:metal_arms"
      duration_millis: 24000
      color_rgb: 13225686
      tissue {
        modifiers {
          slot_id: "muscles"
          curve { offset_millis: 0 value: 0 }
          curve { offset_millis: 1000 value: 1 }
          curve { offset_millis: 20000 value: 1 }
          curve { offset_millis: 24000 value: 0 }
          strength_peak { value: 1.25 unit: RATIO }
          burst_peak { value: 1 unit: RATIO }
          endurance_peak { value: 1 unit: RATIO }
          recovery_peak { value: 1 unit: RATIO }
        }
      }
    }
  }
  effects {
    at_millis: 2600
    sound { sound_id: "meridian_evoker:metal_arms.cast"
      volume { value: 0.6 unit: RATIO }
      pitch { value: 1.2 unit: RATIO }
      anchor: CASTER }
  }
  ai_hints {
    minimum_distance { value: 0 unit: METER }
    maximum_distance { value: 1024 unit: METER }
    maximum_hp_ratio { value: 1 unit: RATIO }
    minimum_qi_ratio { value: 0 unit: RATIO }
    category_weight { value: 0 unit: RATIO }
  }
  presentation { icon_id: "meridian_evoker:metal_arms" display_name: "金臂" description: "鸟飞展翅，肺金之气贯入两臂，两臂力量渐增。" }
}
